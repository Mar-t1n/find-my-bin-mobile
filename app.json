{
  "expo": {
    "name": "Find My Bin",
    "slug": "find-my-binV2-UI",
    "scheme": "findmybin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4EBDD",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.martin2tuff.findmybin.ui"
    },
    "android": {
      "package": "com.martin2tuff.findmybin.ui",
      "adaptiveIcon": {
        "backgroundColor": "#F4EBDD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EBDD",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Find My Bin uses your camera to snap an item and figure out which bin it belongs in.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Find My Bin lets you pick a photo of an item to sort.",
          "cameraPermission": "Find My Bin uses your camera to snap an item and figure out which bin it belongs in.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "react-native-fast-tflite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
